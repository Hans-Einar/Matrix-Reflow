<?xml version='1.0' encoding='UTF-8'?>
<screensaver name="matrix-reflow" _label="Matrix Reflow" gl="yes">
  <command arg="--root" />
  <hgroup>
    <vgroup>
      <number id="speed" type="spinbutton" arg="--speed %" _label="Speed" low="0.0" high="1.0" default="0.35" />
      <number id="density" type="spinbutton" arg="--density %" _label="Density" low="0.05" high="1.0" default="0.9" />
      <number id="scale" type="spinbutton" arg="--scale %" _label="Glyph size" low="0.1" high="2.0" default="0.3" />
      <number id="length" type="spinbutton" arg="--length %" _label="Length bias" low="0.0" high="1.0" default="0.25" />
      <number id="mutation" type="spinbutton" arg="--mutation %" _label="Mutation rate" low="0.0" high="1.0" default="0.1" />
      <boolean id="binary" _label="Binary characters" arg-set="--binary" />
      <boolean id="column-gaps" _label="Column gaps" arg-unset="--no-column-gaps" />
      <boolean id="flip-x" _label="Horizontal glyph flips" arg-unset="--no-flip-x" />
      <boolean id="flip-y" _label="Vertical glyph flips" arg-unset="--no-flip-y" />
      <boolean id="easter-eggs" _label="Clock easter eggs" arg-unset="--no-easter-eggs" />
      <number id="depth" type="spinbutton" arg="--depth %" _label="Depth" low="0.0" high="1.5" default="0.0" />
    </vgroup>
    <vgroup>
      <boolean id="panning" _label="Camera movement" arg-set="--panning" />
      <number id="camera-speed" type="spinbutton" arg="--camera-speed %" _label="Camera speed" low="0.0" high="1.0" default="1.0" />
      <boolean id="fog" _label="Depth fog" arg-unset="--no-fog" />
      <boolean id="textured" _label="Textured glyphs" arg-unset="--no-textured" />
      <boolean id="wireframe" _label="Wireframe" arg-set="--wireframe" />
      <boolean id="extra-contrast-heads" _label="Bright heads" arg-set="--extra-contrast-heads" />
      <boolean id="bloom" _label="Bloom" arg-unset="--no-bloom" />
      <number id="bloom-strength" type="spinbutton" arg="--bloom-strength %" _label="Bloom strength" low="0.0" high="1.0" default="0.9" />
      <boolean id="crt" _label="CRT emulation" arg-set="--crt" />
      <number id="distortion" type="spinbutton" arg="--distortion %" _label="Glass distortion" low="0.0" high="1.0" default="0.0" />
      <number id="fps-limit" type="spinbutton" arg="--fps-limit %" _label="Frame limit" low="1" high="240" default="60" />
    </vgroup>
  </hgroup>
  <_description>Matrix Reflow: OpenGL digital rain with bloom and CRT. All settings and preview use this XScreenSaver dialog. RGB color channels range from 0 to 1. The generated command uses built-in defaults plus these controls, independently of optional CLI profiles.</_description>
  <command arg="--profile 0" />
  <hgroup>
    <vgroup>
      <number id="main-red" type="spinbutton" arg="--main-red %" _label="Rain Red" low="0.0" high="1.0" default="0.05" />
      <number id="main-green" type="spinbutton" arg="--main-green %" _label="Rain Green" low="0.0" high="1.0" default="0.85" />
      <number id="main-blue" type="spinbutton" arg="--main-blue %" _label="Rain Blue" low="0.0" high="1.0" default="0.25" />
    </vgroup>
    <vgroup>
      <number id="glitch-red" type="spinbutton" arg="--glitch-red %" _label="Glitch Red" low="0.0" high="1.0" default="0.85" />
      <number id="glitch-green" type="spinbutton" arg="--glitch-green %" _label="Glitch Green" low="0.0" high="1.0" default="0.05" />
      <number id="glitch-blue" type="spinbutton" arg="--glitch-blue %" _label="Glitch Blue" low="0.0" high="1.0" default="0.05" />
    </vgroup>
  </hgroup>
</screensaver>